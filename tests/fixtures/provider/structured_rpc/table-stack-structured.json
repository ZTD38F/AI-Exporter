{"children":[{"nodeType":17,"rows":[{"cells":[{"children":[{"nodeType":18,"text":"关键工程指标 / 纠错码方案"}]},{"children":[{"nodeType":18,"text":"二维色码"},{"nodeType":13},{"nodeType":18,"text":"(2D Color Code)","annotations":[{"start":0,"end":15,"type":5}]}]},{"children":[{"nodeType":18,"text":"二维旋转表面码"},{"nodeType":13},{"nodeType":18,"text":"(Rotated Planar Surface Code)","annotations":[{"start":0,"end":29,"type":5}]}]},{"children":[{"nodeType":18,"text":"三维 / 拓扑 qLDPC 码"},{"nodeType":13},{"nodeType":18,"text":"(Quantum LDPC Code)","annotations":[{"start":0,"end":19,"type":5}]}]},{"children":[{"nodeType":18,"text":"玻色猫态码"},{"nodeType":13},{"nodeType":18,"text":"(Bosonic Cat Code + 外层码)","annotations":[{"start":0,"end":24,"type":5}]}]}]},{"cells":[{"children":[{"nodeType":18,"text":"物理/逻辑编码开销率 (k/n)","annotations":[{"start":12,"end":15,"type":4},{"start":0,"end":16,"type":0}]}]},{"children":[{"nodeType":18,"text":"极低（渐进趋零）","annotations":[{"start":0,"end":8,"type":0}]},{"nodeType":13},{"nodeType":18,"text":"• k=1 时单逻辑块需要 n \\approx \\frac{3}{4}d^2 到 d^2 级别数据比特","annotations":[{"start":2,"end":5,"type":4},{"start":14,"end":38,"type":4},{"start":41,"end":44,"type":4}]},{"nodeType":13},{"nodeType":18,"text":"• 随码距 d 增加，物理开销与表面码处同一数量级 (k/n \\to 0)","annotations":[{"start":6,"end":7,"type":4},{"start":27,"end":36,"type":4}]}]},{"children":[{"nodeType":18,"text":"极低（渐进趋零）","annotations":[{"start":0,"end":8,"type":0}]},{"nodeType":13},{"nodeType":18,"text":"• k=1 时单逻辑块需要 n = d^2 个数据比特 + d^2-1 个辅助比特（总物理比特数约为 2d^2-1）","annotations":[{"start":2,"end":5,"type":4},{"start":14,"end":21,"type":4},{"start":30,"end":35,"type":4},{"start":51,"end":57,"type":4}]},{"nodeType":13},{"nodeType":18,"text":"• 随 d 增加 k/n \\to 0","annotations":[{"start":4,"end":5,"type":4},{"start":9,"end":18,"type":4}]}]},{"children":[{"nodeType":18,"text":"高（常数渐进编码率）","annotations":[{"start":0,"end":10,"type":0}]},{"nodeType":13},{"nodeType":18,"text":"• k/n = \\Theta(1)，常数级开销","annotations":[{"start":2,"end":17,"type":4}]},{"nodeType":13},{"nodeType":18,"text":"• 典型如双二分双车码（Bivariate Bicycle）：数百物理比特可编码数十个逻辑比特（如 [[144, 12, 12]]），硬件冗余降低 5~10 倍","annotations":[{"start":50,"end":65,"type":4}]}]},{"children":[{"nodeType":18,"text":"极高（连续变量硬件压缩）","annotations":[{"start":0,"end":12,"type":0}]},{"nodeType":13},{"nodeType":18,"text":"• 单个高 Q 谐振腔模式即可内禀编码 1 个量子比特","annotations":[{"start":6,"end":7,"type":4}]},{"nodeType":13},{"nodeType":18,"text":"• 外层仅需结合 1D 线性重复码或小尺寸非对称表面码，物理模/器件级开销大幅削减"}]}]},{"cells":[{"children":[{"nodeType":18,"text":"容错阈值","annotations":[{"start":0,"end":4,"type":0}]},{"nodeType":13},{"nodeType":18,"text":"(电路级噪声模型 / Circuit-Level)","annotations":[{"start":0,"end":25,"type":5}]}]},{"children":[{"nodeType":18,"text":"\\sim 0.3\\% - 0.5\\%","annotations":[{"start":0,"end":18,"type":4},{"start":0,"end":18,"type":0}]},{"nodeType":13},{"nodeType":18,"text":"• 校验面包含 4/6/8 权重算子，单面伴随子抽取线路较深、CNOT 级联更多，错误扩散更严重"},{"nodeType":13},{"nodeType":18,"text":"• 解码超图关联处理复杂度高于表面码"}]},{"children":[{"nodeType":18,"text":"\\sim 0.7\\% - 1.0\\%","annotations":[{"start":0,"end":18,"type":4},{"start":0,"end":18,"type":0}]},{"nodeType":13},{"nodeType":18,"text":"• 业内工程成熟度最高、阈值表现最鲁棒"},{"nodeType":13},{"nodeType":18,"text":"• 校验子权重恒定为 4（内部）或 2（边界），伴随子抽取线路仅需 4 步 CNOT 调度"}]},{"children":[{"nodeType":18,"text":"\\sim 0.3\\% - 0.8\\%","annotations":[{"start":0,"end":18,"type":4},{"start":0,"end":18,"type":0}]},{"nodeType":13},{"nodeType":18,"text":"• 阈值与特定代数构造强相关（检验矩阵稀疏行重/列重较大）"},{"nodeType":13},{"nodeType":18,"text":"• 测量电路需要额外的辅助路由或长程 CNOT，阈值略低于表面码"}]},{"children":[{"nodeType":18,"text":"有效阈值 \\sim 1\\% - 5\\%（偏置噪声下）","annotations":[{"start":5,"end":19,"type":4},{"start":0,"end":26,"type":0}]},{"nodeType":13},{"nodeType":18,"text":"• 内禀相干驱动抑制比特翻转（Bit-flip，随平均光子数 \\vert{}\\alpha\\vert{}^2 指数压制）","annotations":[{"start":31,"end":53,"type":4}]},{"nodeType":13},{"nodeType":18,"text":"• 外层仅纠正相位翻转（Phase-flip），一维纠错阈值极高"}]}]},{"cells":[{"children":[{"nodeType":18,"text":"逻辑门执行开销","annotations":[{"start":0,"end":7,"type":0}]},{"nodeType":13},{"nodeType":18,"text":"(横截门集 vs 格子手术)","annotations":[{"start":0,"end":14,"type":5}]}]},{"children":[{"nodeType":18,"text":"Clifford 全集横截执行","annotations":[{"start":0,"end":15,"type":0}]},{"nodeType":13},{"nodeType":18,"text":"• 横截门： H、S 与 \\text{CNOT} 天然全横截，无需额外时空通道","annotations":[{"start":2,"end":6,"type":0},{"start":7,"end":8,"type":4},{"start":9,"end":10,"type":4},{"start":13,"end":24,"type":4}]},{"nodeType":13},{"nodeType":18,"text":"• 非 Clifford 门： 受制于 Eastin-Knill 定理，仍需通过魔态蒸馏注入 T 门或 3D 色码规范固定转换","annotations":[{"start":2,"end":15,"type":0},{"start":47,"end":48,"type":4}]}]},{"children":[{"nodeType":18,"text":"横截门极度受限","annotations":[{"start":0,"end":7,"type":0}]},{"nodeType":13},{"nodeType":18,"text":"• 横截门： 仅逻辑块间 \\text{CNOT} 可横截","annotations":[{"start":2,"end":6,"type":0},{"start":13,"end":24,"type":4}]},{"nodeType":13},{"nodeType":18,"text":"• 单比特门： H、S 均非横截，必须执行消耗 O(d) 时间与物理辅助碎片的晶格手术（Lattice Surgery）","annotations":[{"start":2,"end":7,"type":0},{"start":8,"end":9,"type":4},{"start":10,"end":11,"type":4},{"start":24,"end":28,"type":4}]},{"nodeType":13},{"nodeType":18,"text":"• 非 Clifford 门： 依赖魔态蒸馏与隐形传态电路","annotations":[{"start":2,"end":15,"type":0}]}]},{"children":[{"nodeType":18,"text":"高度依赖非局域编织/置换","annotations":[{"start":0,"end":12,"type":0}]},{"nodeType":13},{"nodeType":18,"text":"• 横截门： 依赖特定同构自同构群，部分码族可横截实现特定块间 Clifford 门","annotations":[{"start":2,"end":6,"type":0}]},{"nodeType":13},{"nodeType":18,"text":"• 通用门： 格子手术难以直接应用，普遍采用高维流形折叠或动态置换网络（Permutation routing），逻辑寻址调度复杂","annotations":[{"start":2,"end":6,"type":0}]}]},{"children":[{"nodeType":18,"text":"保偏门（Bias-preserving Gates）优势","annotations":[{"start":0,"end":28,"type":0}]},{"nodeType":13},{"nodeType":18,"text":"• 横截门： 可原生实现保偏受控非门（\\text{CX}）、受控相位门（\\text{CZ}）以及非 Clifford 的 Toffoli 门","annotations":[{"start":2,"end":6,"type":0},{"start":19,"end":28,"type":4},{"start":36,"end":45,"type":4}]},{"nodeType":13},{"nodeType":18,"text":"• 非偏置门： 需要辅助驱动微波脉冲或魔态蒸馏，但蒸馏资源开销显著轻量化","annotations":[{"start":2,"end":7,"type":0}]}]}]},{"cells":[{"children":[{"nodeType":18,"text":"硬件布线连接性要求","annotations":[{"start":0,"end":9,"type":0}]},{"nodeType":13},{"nodeType":18,"text":"(超导芯片 vs 中性原子)","annotations":[{"start":0,"end":14,"type":5}]}]},{"children":[{"nodeType":18,"text":"2D 局部连通（度数为 3）","annotations":[{"start":0,"end":14,"type":0}]},{"nodeType":13},{"nodeType":18,"text":"• 超导： 需蜂窝晶格或截角正方形晶格（4.8.8），平面内交叉布线多于表面码","annotations":[{"start":2,"end":5,"type":0}]},{"nodeType":13},{"nodeType":18,"text":"• 中性原子： 极高契合度，三价顶点与多色面测量容易映射至 SLM 静态光镊网格","annotations":[{"start":2,"end":7,"type":0}]}]},{"children":[{"nodeType":18,"text":"严格 2D 平面最近邻（度数为 4）","annotations":[{"start":0,"end":18,"type":0}]},{"nodeType":13},{"nodeType":18,"text":"• 超导： 行业黄金标准，完美契合标准方格芯片单层/倒装焊工艺（如 Sycamore、天目架构）","annotations":[{"start":2,"end":5,"type":0}]},{"nodeType":13},{"nodeType":18,"text":"• 中性原子： 适配标准二维正方光镊点阵阵列，无长程跳线开销","annotations":[{"start":2,"end":7,"type":0}]}]},{"children":[{"nodeType":18,"text":"全域/非局域长程连接（Long-range）","annotations":[{"start":0,"end":22,"type":0}]},{"nodeType":13},{"nodeType":18,"text":"• 超导： 极难实现，必须依赖多层 3D 硅通孔（TSV）、片间同轴线或谐振腔总线跳线","annotations":[{"start":2,"end":5,"type":0}]},{"nodeType":13},{"nodeType":18,"text":"• 中性原子： 核心主战场，利用 AOD 双光镊动态穿梭（Shuttling）即可低损耗实现跨区域连接","annotations":[{"start":2,"end":7,"type":0}]}]},{"children":[{"nodeType":18,"text":"微波腔-量子比特混合互连","annotations":[{"start":0,"end":12,"type":0}]},{"nodeType":13},{"nodeType":18,"text":"• 超导： 必须集成高 Q 值 3D 铝/铌微波超导谐振腔与非线性驱动源（SNAIL/ATS 芯片），集成体积与封装复杂度极高","annotations":[{"start":2,"end":5,"type":0},{"start":12,"end":13,"type":4}]},{"nodeType":13},{"nodeType":18,"text":"• 中性原子： 不适用（中性原子体系主要基于微观声子/里德堡相互作用，非连续变量宏观微波腔）","annotations":[{"start":2,"end":7,"type":0}]}]}]}]}]}