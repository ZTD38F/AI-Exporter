            {
              "id": "p03-b48",
              "type": "code",
              "code": "def compute_attention_scores(query, key, scale=True):\n    \"\"\"Compute scaled dot-product attention scores.\"\"\"\n    d_k = query.shape[-1]\n    scores = query @ key.transpose(-2, -1)\n    if scale:\n        scores = scores / math.sqrt(d_k)\n    # 数值稳定性：减去每行最大值\n    scores = scores - scores.max(dim=-1, keepdim=True).values\n    return torch.softmax(scores, dim=-1)",
              "language": "python"
            },
            {
              "id": "p03-b49",
              "type": "paragraph",
              "children": [
                {
                  "type": "text",
                  "text": "第 9 行的 "
                },
                {
                  "type": "inlineCode",
                  "code": "scores.max(dim=-1, keepdim=True)"
                },
                {
                  "type": "text",
                  "text": " 是为了数值稳定性，建议保留。"
                }
              ]
            },
            {
              "id": "p03-b50",
              "type": "heading",
              "level": 3,
              "children": [
                {
                  "type": "text",
                  "text": "2. 前端节流函数"
                }
              ]
            },
            {
              "id": "p03-b51",
              "type": "code",
              "code": "export function throttle(fn, wait = 300) {\n  let lastCall = 0;\n  let timer = null;\n  return function (...args) {\n    const now = Date.now();\n    const remaining = wait - (now - lastCall);\n    if (remaining <= 0) {\n      lastCall = now;\n      fn.apply(this, args);\n    } else if (!timer) {\n      timer = setTimeout(() => {\n        lastCall = Date.now();\n        timer = null;\n        fn.apply(this, args);\n      }, remaining);\n    }\n  };\n}",
              "language": "javascript"
            },
            {
              "id": "p03-b52",
              "type": "heading",
              "level": 3,
              "children": [
                {
                  "type": "text",
                  "text": "3. 部署脚本"
