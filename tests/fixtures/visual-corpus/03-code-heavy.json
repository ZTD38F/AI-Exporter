                {
                  "type": "text",
                  "text": "5. SQL 建表语句"
                }
              ]
            },
            {
              "id": "p03-b59",
              "type": "code",
              "language": "sql",
              "code": "CREATE TABLE review_comments (\n  id          BIGINT PRIMARY KEY AUTO_INCREMENT,\n  diff_id     VARCHAR(64)  NOT NULL,\n  file_path   VARCHAR(512) NOT NULL,\n  line_no     INT          NOT NULL,\n  author      VARCHAR(128) NOT NULL,\n  body        TEXT         NOT NULL,\n  created_at  TIMESTAMP    NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  INDEX idx_diff_file (diff_id, file_path)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;\n\n-- 找出每个 diff 下评论最多的文件\nSELECT diff_id, file_path, COUNT(*) AS c\nFROM review_comments\nGROUP BY diff_id, file_path\nORDER BY c DESC\nLIMIT 20;"
            },
            {
              "id": "p03-b60",
              "type": "heading",
              "level": 3,
              "children": [
                {
                  "type": "text",
                  "text": "6. Go 统计逻辑"
                }
              ]
            },
            {
              "id": "p03-b61",
              "type": "code",
              "language": "go",
              "code": "package reviewer\n\nimport (\n    \"context\"\n    \"fmt\"\n    \"time\"\n)\n\n// Comment 是一条 review 留言。\ntype Comment struct {\n    ID        int64\n    DiffID    string\n    FilePath  string\n    LineNo    int\n    Author    string\n    Body      string\n    CreatedAt time.Time\n}\n\n// TopFiles 返回评论最多的前 N 个文件。\nfunc TopFiles(ctx context.Context, comments []Comment, n int) []string {\n    counts := make(map[string]int)\n    for _, c := range comments {\n        select {\n        case <-ctx.Done():\n            return nil\n        default:\n        }\n        counts[c.FilePath]++\n    }\n    return takeTop(counts, n)\n}"
            },
