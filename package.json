{
  "name": "gemini-exporter",
  "version": "2.1.1",
  "description": "100% Free & open-source • 100% local, no tracking • One-click export all chats • PDF, HTML & Markdown • Hands-off background export",
  "main": "background.js",
  "scripts": {
    "build": "node build.js",
    "package": "node build.js --pack",
    "lint": "oxlint -A all -W typescript/no-explicit-any -W typescript/no-unsafe-assignment -W typescript/no-unsafe-argument -W typescript/no-unsafe-call -W typescript/no-unsafe-member-access -W typescript/no-unsafe-return -W typescript/no-unsafe-type-assertion -D typescript/no-floating-promises --type-aware src/",
    "type-check": "tsc --noEmit",
    "test": "node scripts/check-zero-any.cjs && npm run type-check && npm run test:unit && node build.js && npm run test:release-fonts && playwright test",
    "test:unit": "python3 tests/run_tests.py",
    "test:changed": "python3 scripts/run_changed_tests.py",
    "test:gemini-dual": "node -r ./tests/ts_register.js scripts/check_gemini_dual_parse.ts",
    "test:tier2": "python3 scripts/test_live_chat_and_export.py",
    "test:upgrade": "node scripts/test_upgrade_profile.mjs",
    "release": "gh workflow run release.yml --ref main",
    "test:v2-modules": "node scripts/test-v2-modules.cjs",
    "test:l2:unit": "node scripts/test-l2.cjs --unit-only",
    "test:l3b:unit": "node scripts/test-l3b.cjs",
    "test:v2:unit-isolation": "node scripts/test-v2-unit-isolation.cjs",
    "test:v2:unit-ports": "node scripts/typecheck-v2-unit-ports.cjs",
    "test:release-fonts": "node scripts/release-gate-checks/check-bundled-fonts.js"
  },
  "keywords": [
    "gemini",
    "google-gemini",
    "exporter",
    "markdown",
    "chrome-extension",
    "open-source"
  ],
  "author": "Wenbo Cui",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/chrome": "^0.2.9",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.5.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.6",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2002",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@myriaddreamin/typst-ts-renderer": "0.7.0",
    "@myriaddreamin/typst-ts-web-compiler": "0.7.0",
    "@myriaddreamin/typst.ts": "0.7.0",
    "@types/mdast": "^4.0.4",
    "@xmldom/xmldom": "0.9.12",
    "docx": "9.14.0",
    "katex": "^0.18.9",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "pdf-lib": "1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
