{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_extName__",
  "version": "2.1.1",
  "description": "__MSG_extDesc__",
  "permissions": [
    "scripting",
    "activeTab",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [],
  "optional_host_permissions": [
    "https://gemini.google.com/*",
    "https://*.googleusercontent.com/*",
    "https://*.usercontent.google.com/*",
    "https://drive.google.com/*",
    "https://lh3.google.com/*",
    "https://*.gstatic.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/ui/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16_gray.png",
      "48": "icons/icon48_gray.png",
      "128": "icons/icon128_gray.png"
    }
  },
  "options_page": "src/ui/options/options.html",
  "background": {
    "service_worker": "dist/background/background.js"
  },
  "sandbox": {
    "pages": [
      "src/l4/format/pdf/sandbox/typst-compile.html"
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';",
    "sandbox": "sandbox allow-scripts; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval';"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "dist/content/hook.js",
        "icons/*",
        "lib/*"
      ],
      "matches": [
        "https://gemini.google.com/*"
      ]
    }
  ]
}
